            "def": "CREATE TRIGGER trg_inventory_batches_carrying_write_down BEFORE INSERT OR UPDATE ON public.inventory_batches FOR EACH ROW EXECUTE FUNCTION inventory_batches_carrying_write_down_guard()"
          }
